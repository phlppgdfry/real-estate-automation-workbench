    "/api/dify/analyse": {
      "post": {
        "operationId": "difyAnalyse",
        "summary": "Analyseer een fictieve aanvraag (reviewer)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "additionalProperties": false,
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 4000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gecontroleerd resultaat; geen dossiermutatie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["extraction", "run"],
                  "properties": {
                    "extraction": {
                      "type": "object",
                      "required": ["intent", "reference", "evidence"],
                      "properties": {
                        "intent": {
                          "type": "string",
                          "enum": ["visit", "valuation", "search", "unknown"]
                        },
                        "reference": {
                          "type": "string",
