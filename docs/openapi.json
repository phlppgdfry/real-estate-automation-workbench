  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "WebhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-signature"
      }
    },
    "schemas": {
      "Intake": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "name", "email", "message", "channel"],
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{3,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 10,
            "maxLength": 4000
          },
          "channel": {
            "type": "string",
            "enum": ["website", "email", "portal"]
          }
        }
      },
      "Lead": {
        "allOf": [
          {
            "type": "object",
            "required": ["eventId", "name", "email", "message", "channel"],
            "properties": {
              "eventId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{3,80}$"
              },
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100
              },
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 200
              },
              "message": {
                "type": "string",
                "minLength": 10,
                "maxLength": 4000
              },
              "channel": {
                "type": "string",
                "enum": ["website", "email", "portal"]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "version",
              "receivedAt",
              "status",
              "extraction",
              "reasons",
              "draft",
              "attempts",
              "audit"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              },
              "receivedAt": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string",
                "enum": ["review", "manual", "queued", "synced", "dead"]
              },
              "extraction": {
                "type": "object",
                "properties": {
                  "intent": {
                    "type": "string",
                    "enum": ["visit", "valuation", "search", "unknown"]
                  },
                  "reference": {
                    "type": "string",
                    "nullable": true
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "draft": {
                "type": "string"
              },
              "attempts": {
                "type": "integer"
              },
              "approvedBy": {
                "type": "string"
              },
              "approvedAt": {
                "type": "string",
                "format": "date-time"
              },
              "nextAttemptAt": {
                "type": "string",
                "format": "date-time"
              },
              "audit": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["at", "action", "detail"],
                  "properties": {
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "action": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Receipt": {
        "type": "object",
        "required": ["eventId", "state", "attempts", "version", "duplicate", "statusUrl"],
        "properties": {
          "eventId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["pending", "processing", "retry", "completed", "dead"]
          },
          "attempts": {
            "type": "integer"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "duplicate": {
            "type": "boolean"
          },
          "statusUrl": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
