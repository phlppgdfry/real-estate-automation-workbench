{
  "openapi": "3.0.3",
  "info": {
    "title": "Duin & Dorp local lab API",
    "version": "2.2.0",
    "description": "Fictieve portfolio-case. CRM is een lokale duurzame mock. Geen e-mailtransport.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4318"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Labstatus zonder gevoelige data",
        "responses": {
          "200": {
            "description": "Beschikbaar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": ["rules", "openai", "dify"]
                    },
                    "crm": {
                      "type": "string"
                    },
                    "sentEmails": {
                      "type": "integer",
                      "enum": [0]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/leads": {
      "post": {
        "operationId": "ingestLead",
        "summary": "Duurzaam ontvangen v\u00f3\u00f3r analyse",
        "description": "HMAC op timestamp + punt + exacte body. Ontvangst is opgeslagen v\u00f3\u00f3r 202. Analyse gebeurt afzonderlijk; 200 bij eerder voltooide analyse. Zelfde ID met andere inhoud geeft 409.",
        "security": [
          {
            "WebhookSignature": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "x-timestamp",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Intake"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Validatie-, toegangs- of procesfout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Validatie-, toegangs- of procesfout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Validatie-, toegangs- of procesfout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Validatie-, toegangs- of procesfout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Validatie-, toegangs- of procesfout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Eerder voltooid ontvangstbewijs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "202": {
            "description": "Duurzaam opgeslagen; analyse pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Statusendpoint (leestoegang vereist)",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
