  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "WebhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-signature"
      }
    },
    "schemas": {
      "Intake": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "name", "email", "message", "channel"],
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{3,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 10,
            "maxLength": 4000
          },
          "channel": {
            "type": "string",
            "enum": ["website", "email", "portal"]
          }
        }
      },
      "Lead": {
        "allOf": [
          {
            "type": "object",
            "required": ["eventId", "name", "email", "message", "channel"],
            "properties": {
              "eventId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{3,80}$"
              },
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100
              },
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 200
              },
              "message": {
                "type": "string",
                "minLength": 10,
                "maxLength": 4000
              },
              "channel": {
                "type": "string",
                "enum": ["website", "email", "portal"]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "version",
              "receivedAt",
              "status",
              "extraction",
              "reasons",
              "draft",
              "attempts",
              "audit"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              },
              "receivedAt": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string",
                "enum": ["review", "manual", "queued", "synced", "dead"]
              },
              "extraction": {
                "type": "object",
                "properties": {
                  "intent": {
                    "type": "string",
                    "enum": ["visit", "valuation", "search", "unknown"]
                  },
                  "reference": {
                    "type": "string",
                    "nullable": true
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "draft": {
                "type": "string"
              },
              "attempts": {
                "type": "integer"
              },
              "approvedBy": {
                "type": "string"
              },
              "approvedAt": {
                "type": "string",
                "format": "date-time"
              },
              "nextAttemptAt": {
                "type": "string",
                "format": "date-time"
              },
              "audit": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["at", "action", "detail"],
                  "properties": {
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "action": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Receipt": {
        "type": "object",
        "required": ["eventId", "state", "attempts", "version", "duplicate", "statusUrl"],
        "properties": {
          "eventId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["pending", "processing", "retry", "completed", "dead"]
          },
          "attempts": {
            "type": "integer"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "duplicate": {
            "type": "boolean"
          },
          "statusUrl": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "DifyAssistance": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": ["source_id", "quote"],
              "additionalProperties": false
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string"
          },
          "requires_human": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["summary", "facts", "risks", "next_action", "requires_human"],
        "additionalProperties": false
      },
      "DifyDocumentReview": {
        "type": "object",
        "properties": {
          "document_type": {
            "type": "string",
            "enum": ["property-sheet", "other", "unknown"]
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": ["reference", "price", "city", "status", "epc", "area"]
                },
                "value": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": ["field", "value", "quote"],
              "additionalProperties": false
            }
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Onbevestigde velden: code vult referentie, prijs, gemeente en status zonder gevalideerd citaat aan. Dit is geen juridische volledigheidstoets."
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_human": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["document_type", "facts", "missing_fields", "risks", "requires_human"],
        "additionalProperties": false
      }
    }
  }
}
