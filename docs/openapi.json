                    "proposal": {
                      "$ref": "#/components/schemas/DifyAssistance"
                    },
                    "sourceFacts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "text"],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "run": {
                      "type": "object",
                      "properties": {
                        "conversationId": {
                          "type": "string"
                        },
                        "messageId": {
                          "type": "string"
                        }
                      }
                    },
                    "requires_human": {
                      "type": "boolean",
